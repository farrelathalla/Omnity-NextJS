# Copy to .env.local (dev) or set in hPanel > Node.js > Environment variables (prod).
# Never commit real values.

# --- Site ---
# development | staging | production. "staging" adds noindex headers + a preview badge.
SITE_ENV=development
SITE_URL=http://localhost:3000

# --- Database (MySQL / MariaDB), used from phase 3 ---
# Hostinger: connect to 127.0.0.1:3306 from the app.
DATABASE_URL=mysql://omnity:omnity_dev@127.0.0.1:3307/omnity

# --- Auth, used from phase 4 ---
# 32+ random bytes, e.g. `openssl rand -base64 48`
AUTH_SECRET=change-me
# First admin, created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# --- Google sign-in (optional, phase 5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (SMTP), used from phase 3. Empty SMTP_HOST = log emails to the console. ---
MAIL_FROM="Omnity <no-reply@omnity.co.id>"
MAIL_ADMIN_TO=corporate@omnity.co.id
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Uploads, used from phase 4. Keep OUTSIDE the app folder in production. ---
UPLOAD_DIR=./storage/uploads

# --- Boot tasks (hosts without a convenient shell, e.g. Hostinger) ---
# AUTO_MIGRATE=1 applies pending DB migrations on start and creates the FIRST admin from
# ADMIN_EMAIL / ADMIN_PASSWORD when no admin exists (never resets an existing one).
AUTO_MIGRATE=0
